# ============================================================================
# FreeCut Universal Studio Bot (v6) — Optional Accelerator Keys (.env)
# ============================================================================
# NENHUMA CHAVE ABAIXO É OBRIGATÓRIA!
# Sem nenhuma chave configurada, o bot já funciona 100% GRÁTIS usando:
#   - Transcrição word-by-word local: `faster-whisper` (GPU CUDA ou CPU int8)
#   - Narração TTS opcional (se enviar só texto): `edge-tts` neural gratuito
#   - Imagens/Vídeos reais: Bing, DuckDuckGo, Google News, Wikimedia, YouTube (yt-dlp)
#   - Mapas reais: Natural Earth GeoJSON offline (242 países) + MapLibre/OpenFreeMap
# ============================================================================

# [OPCIONAL] Transcrição em nuvem ultra-rápida (Groq tem tier gratuito!)
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=

# [OPCIONAL] Vídeos/Fotos Stock de apoio para cenas abstratas (Pexels e Pixabay são gratuitas!)
PEXELS_API_KEY=
PIXABAY_API_KEY=

# [OPCIONAL] Fotos oficiais de cinema/séries (TMDB é gratuita!)
TMDB_API_KEY=

# [OPCIONAL] Narração premium se você enviar apenas texto em vez de áudio pronto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
