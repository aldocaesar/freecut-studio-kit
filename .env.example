# ============================================================================
# FreeCut Universal Studio Kit (v7.2 Final) — Optional Accelerator Keys (.env)
# ============================================================================
# NENHUMA CHAVE ABAIXO É OBRIGATÓRIA!
# Sem nenhuma chave configurada, o bot já funciona 100% GRÁTIS usando:
#   - Transcrição word-by-word local: `faster-whisper` (GPU CUDA ou CPU int8)
#   - Narração TTS opcional (se enviar só texto): `edge-tts` neural gratuito
#   - Imagens/Vídeos reais: Bing, News RSS, Wikimedia, Yandex, Openverse, YouTube (yt-dlp)
#   - Mapas reais: Natural Earth GeoJSON offline (242 países)
# ============================================================================

# [RECOMENDADO — 100% GRÁTIS] Vídeos 1080p + Fotos HD de Stock para B-roll abstrato
# Crie sua chave gratuita na hora em: https://pixabay.com/api/docs/
# (Substitui 100% o Pexels, que pausou emissão de novas chaves de API!)
PIXABAY_API_KEY=

# [OPCIONAL] Transcrição em nuvem ultra-rápida (Groq tem tier gratuito!)
GROQ_API_KEY=
ASSEMBLYAI_API_KEY=

# [OPCIONAL] Fotos oficiais de cinema/séries (TMDB é gratuita!)
TMDB_API_KEY=

# [OPCIONAL] Narração premium se você enviar apenas texto em vez de áudio pronto
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# [LEGADO OPCIONAL] Caso você já possua uma chave antiga do Pexels
PEXELS_API_KEY=
